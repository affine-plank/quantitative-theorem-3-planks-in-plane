module
/-
# Symmetry — the moves, the sectors, and the four chambers

Configurations carry a large symmetry group, and every argument below
works up to it.  The group is generated by four kinds of **moves**:

* `relabel` — permute the three planks (`S₃`);
* `flip`    — replace a normal by its negative, swapping the window;
* `scale`   — rescale a normal (and its window) by a positive factor;
* `triSym`  — an affine symmetry of the standard triangle (the six
  affine maps permuting its vertices; determinant `±1`, so even the gap
  *area* is preserved).

Moves preserve covering, `Σ rw`, and gap area (§2).  Up to moves, a
normal lands in one of three **sectors** — named by the pair of vertices
whose shadows realize the triangle's width (§3) — and a configuration
lands in one of four **chambers** T, C, D, E by the multiset of sectors
its normals occupy (§4).  Chamber E (one normal per sector) is where all
the difficulty lives.

This replaces the angle-form machinery entirely: the old
`ConfigStep`/`ConfigEquiv` on angle triples (`Dim2N3/TightSectorCensus`,
`TightSymmetry`, `TightEquivariance`), the `D₃ × S₃` census with its
`[−π/6, 5π/6)` window, and the cell-orbit generators `s12`/`r`
(`Dim2N3/TightCellOrbit`).  No trigonometry survives: sectors are sign
conditions and the triangle symmetries are rational affine maps.
-/
public import Plank.Core
public import Plank.Proofs.Symmetry

@[expose] public section


public section

noncomputable section

open Proofs.Basic Proofs.Transport Proofs.Symmetry

/-! ## §1  The moves -/

/-- The rotation `A ↦ B ↦ C ↦ A` of the standard triangle, as the
affine map `(x, y) ↦ (1 − x − y, x)`. -/
@[expose] def rotStd (P : ℝ × ℝ) : ℝ × ℝ := (1 - P.1 - P.2, P.1)

/-- The reflection `B ↔ C` of the standard triangle, as the linear map
`(x, y) ↦ (y, x)`. -/
@[expose] def swapStd (P : ℝ × ℝ) : ℝ × ℝ := (P.2, P.1)

-- Drift guards (DESIGN.md A8): the mirror's raw shadows are
-- definitionally these two maps; if either body changes, fail here.
example : rotStd = Proofs.Symmetry.rotMap := rfl
example : swapStd = Proofs.Symmetry.swapMap := rfl

/-- One **move** between configurations.  Each constructor records a
generator of the symmetry group together with its action on the planks'
data; the transported plank data is spelled out so that every move is
elementary arithmetic. -/
inductive Move : Config → Config → Prop
  /-- Permute the three planks. -/
  | relabel (C : Config) (σ : Equiv.Perm (Fin 3)) :
      Move C ⟨C.plank ∘ σ⟩
  /-- Negate the `i`-th normal, swapping and negating its window. -/
  | flip (C : Config) (i : Fin 3) (h : ∀ j, j = i →
      (-(C.plank j).u ≠ 0)) :
      Move C ⟨fun j => if hj : j = i then
        ⟨-(C.plank j).u, -(C.plank j).hi, -(C.plank j).lo,
          h j hj, neg_le_neg (C.plank j).lo_le_hi⟩
        else C.plank j⟩
  /-- Rescale the `i`-th normal and window by a positive factor. -/
  | scale (C : Config) (i : Fin 3) (c : ℝ) (hc : 0 < c)
      (h : c • (C.plank i).u ≠ 0)
      (hle : c * (C.plank i).lo ≤ c * (C.plank i).hi) :
      Move C ⟨Function.update C.plank i
        ⟨c • (C.plank i).u, c * (C.plank i).lo, c * (C.plank i).hi,
          h, hle⟩⟩
  /-- Pull every plank back along the rotation `rotStd`: normals map by
  the transpose `(u₁, u₂) ↦ (u₂ − u₁, −u₁)` and windows shift by the
  translation part `dot u (1, 0)`. -/
  | rot (C : Config) (h : ∀ j, ((C.plank j).u.2 - (C.plank j).u.1,
      -(C.plank j).u.1) ≠ (0 : ℝ × ℝ)) :
      Move C ⟨fun j =>
        ⟨((C.plank j).u.2 - (C.plank j).u.1, -(C.plank j).u.1),
          (C.plank j).lo - (C.plank j).u.1,
          (C.plank j).hi - (C.plank j).u.1,
          h j, sub_le_sub_right (C.plank j).lo_le_hi _⟩⟩
  /-- Pull every plank back along the reflection `swapStd`: normals swap
  coordinates, windows are unchanged. -/
  | swap (C : Config) (h : ∀ j,
      (((C.plank j).u.2, (C.plank j).u.1) : ℝ × ℝ) ≠ 0) :
      Move C ⟨fun j =>
        ⟨((C.plank j).u.2, (C.plank j).u.1),
          (C.plank j).lo, (C.plank j).hi, h j, (C.plank j).lo_le_hi⟩⟩

/-- Two configurations are **equivalent** if a chain of moves joins
them. -/
@[expose] def Config.Equiv : Config → Config → Prop := Relation.EqvGen Move

/-! ## §2  Moves preserve everything that matters -/

/-- Moves preserve the covering property. -/
theorem Move.covers_iff {C C' : Config} (m : Move C C') :
    C.Covers ↔ C'.Covers := by
  induction m with
  | relabel σ =>
    constructor
    · intro hc P hP
      obtain ⟨j, hj⟩ := hc P hP
      exact ⟨σ.symm j, by simpa using hj⟩
    · intro hc P hP
      obtain ⟨j, hj⟩ := hc P hP
      exact ⟨σ j, hj⟩
  | flip i h =>
    refine covers_congr fun j P => ?_
    by_cases hj : j = i
    · simp only [dif_pos hj, mem_plank_iff, dot_neg_left]
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨by linarith, by linarith⟩
      · rintro ⟨h1, h2⟩; exact ⟨by linarith, by linarith⟩
    · simp [dif_neg hj]
  | scale i c hc h hle =>
    refine covers_congr fun j P => ?_
    by_cases hj : j = i
    · subst hj
      simp only [Function.update_self, mem_plank_iff, dot_smul_left]
      constructor
      · rintro ⟨h1, h2⟩
        exact ⟨le_of_mul_le_mul_left h1 hc, le_of_mul_le_mul_left h2 hc⟩
      · rintro ⟨h1, h2⟩
        exact ⟨by nlinarith, by nlinarith⟩
    · simp [Function.update_of_ne hj]
  | rot h =>
    refine covers_chart rotStd (fun _ hP => rotMap_mem hP)
      (fun _ hQ => rotMap_surj hQ) fun j P => ?_
    simp only [mem_plank_iff, dot, rotStd]
    constructor
    · rintro ⟨h1, h2⟩; exact ⟨by nlinarith, by nlinarith⟩
    · rintro ⟨h1, h2⟩; exact ⟨by nlinarith, by nlinarith⟩
  | swap h =>
    refine covers_chart swapStd (fun _ hP => swapMap_mem hP)
      (fun Q hQ => ⟨swapStd Q, swapMap_mem hQ, swapMap_involutive Q⟩) fun j P => ?_
    simp only [mem_plank_iff, dot, swapStd]
    constructor
    · rintro ⟨h1, h2⟩; exact ⟨by nlinarith, by nlinarith⟩
    · rintro ⟨h1, h2⟩; exact ⟨by nlinarith, by nlinarith⟩

/-- Moves preserve the ledger `Σ rw`. -/
theorem Move.sumRelW_eq {C C' : Config} (m : Move C C') :
    C.sumRelW = C'.sumRelW := by
  induction m with
  | relabel σ =>
    simp only [Config.sumRelW, Config.relW]
    exact (Equiv.sum_comp σ fun j => (C.plank j).relWidth stdTriangle).symm
  | flip i h =>
    refine Finset.sum_congr rfl fun j _ => ?_
    by_cases hj : j = i
    · simp only [Config.relW, dif_pos hj, Plank.relWidth, width_neg]
      ring_nf
    · simp [Config.relW, dif_neg hj]
  | scale i c hc h hle =>
    refine Finset.sum_congr rfl fun j _ => ?_
    by_cases hj : j = i
    · subst hj
      simp only [Config.relW, Function.update_self, Plank.relWidth,
        width_smul, abs_of_pos hc, ← mul_sub]
      rw [mul_div_mul_left _ _ (ne_of_gt hc)]
    · simp [Config.relW, Function.update_of_ne hj]
  | rot h =>
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [Config.relW, Plank.relWidth, width_rot]
    ring_nf
  | swap h =>
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [Config.relW, Plank.relWidth, width_swap]

/-- Moves preserve the gap area (the triangle symmetries have
determinant `±1`, and the other moves fix the uncovered set). -/
theorem Move.gapArea_eq {C C' : Config} (m : Move C C') :
    C.gapArea = C'.gapArea := by
  have key : MeasureTheory.volume C.uncovered = MeasureTheory.volume C'.uncovered := by
    induction m with
    | relabel σ =>
      congr 1
      simp only [Config.uncovered]
      congr 1
      ext P
      simp only [Set.mem_iUnion]
      exact ⟨fun ⟨j, hj⟩ => ⟨σ.symm j, by simpa using hj⟩, fun ⟨j, hj⟩ => ⟨σ j, hj⟩⟩
    | flip i h =>
      congr 1
      refine (uncovered_congr fun j => ?_).symm
      by_cases hj : j = i
      · ext P
        simp only [Plank.set, Set.mem_setOf_eq, dif_pos hj, mem_plank_iff, dot_neg_left]
        constructor
        · rintro ⟨h1, h2⟩; exact ⟨by linarith, by linarith⟩
        · rintro ⟨h1, h2⟩; exact ⟨by linarith, by linarith⟩
      · simp [dif_neg hj]
    | scale i c hc h hle =>
      congr 1
      refine (uncovered_congr fun j => ?_).symm
      by_cases hj : j = i
      · subst hj
        ext P
        simp only [Plank.set, Set.mem_setOf_eq, Function.update_self, mem_plank_iff,
          dot_smul_left]
        constructor
        · rintro ⟨h1, h2⟩
          exact ⟨le_of_mul_le_mul_left h1 hc, le_of_mul_le_mul_left h2 hc⟩
        · rintro ⟨h1, h2⟩
          exact ⟨by nlinarith, by nlinarith⟩
      · simp [Function.update_of_ne hj]
    | rot h =>
      refine (volume_uncovered_chart rotStd rotMap_mem_iff volume_preimage_rotMap
        fun j P => ?_).symm
      simp only [mem_plank_iff, dot, rotStd]
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨by nlinarith, by nlinarith⟩
      · rintro ⟨h1, h2⟩; exact ⟨by nlinarith, by nlinarith⟩
    | swap h =>
      refine (volume_uncovered_chart swapStd swapMap_mem_iff volume_preimage_swapMap
        fun j P => ?_).symm
      simp only [mem_plank_iff, dot, swapStd]
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨by nlinarith, by nlinarith⟩
      · rintro ⟨h1, h2⟩; exact ⟨by nlinarith, by nlinarith⟩
  simp only [Config.gapArea, key]

/-- The ledger is an invariant of the equivalence relation. -/
theorem Config.Equiv.sumRelW_eq {C C' : Config} (h : C.Equiv C') :
    C.sumRelW = C'.sumRelW := by
  induction h with
  | rel _ _ m => exact Move.sumRelW_eq m
  | refl _ => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- The gap area is an invariant of the equivalence relation. -/
theorem Config.Equiv.gapArea_eq {C C' : Config} (h : C.Equiv C') :
    C.gapArea = C'.gapArea := by
  induction h with
  | rel _ _ m => exact Move.gapArea_eq m
  | refl _ => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Covering is an invariant of the equivalence relation. -/
theorem Config.Equiv.covers_iff {C C' : Config} (h : C.Equiv C') :
    C.Covers ↔ C'.Covers := by
  induction h with
  | rel _ _ m => exact Move.covers_iff m
  | refl _ => exact Iff.rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Nonvoid windows are a move invariant: every generator acts on a
window by a shift, a positive scaling, a negation or not at all. -/
theorem Move.windowPos_iff {C C' : Config} (m : Move C C') :
    (∀ i, (C.plank i).lo < (C.plank i).hi) ↔
      (∀ i, (C'.plank i).lo < (C'.plank i).hi) := by
  induction m with
  | relabel σ =>
    exact ⟨fun h i => h (σ i), fun h i => by simpa using h (σ.symm i)⟩
  | flip i hne =>
    refine ⟨fun h j => ?_, fun h j => ?_⟩
    · by_cases hj : j = i
      · simp only [dif_pos hj]; linarith [h j]
      · simpa [dif_neg hj] using h j
    · have hh := h j
      by_cases hj : j = i
      · simp only [dif_pos hj] at hh; linarith
      · simpa [dif_neg hj] using hh
  | scale i c hc hne hle =>
    refine ⟨fun h j => ?_, fun h j => ?_⟩
    · by_cases hj : j = i
      · subst hj; simp only [Function.update_self]; nlinarith [h j]
      · simpa [Function.update_of_ne hj] using h j
    · have hh := h j
      by_cases hj : j = i
      · subst hj; simp only [Function.update_self] at hh; nlinarith [hh]
      · simpa [Function.update_of_ne hj] using hh
  | rot hne =>
    refine ⟨fun h j => ?_, fun h j => ?_⟩
    · have hh := h j
      show (C.plank j).lo - (C.plank j).u.1 < (C.plank j).hi - (C.plank j).u.1
      linarith
    · have hh : (C.plank j).lo - (C.plank j).u.1
          < (C.plank j).hi - (C.plank j).u.1 := h j
      linarith
  | swap hne => exact ⟨fun h j => h j, fun h j => h j⟩

/-- …and hence an invariant of the equivalence relation. -/
theorem Config.Equiv.windowPos_iff {C C' : Config} (h : C.Equiv C') :
    (∀ i, (C.plank i).lo < (C.plank i).hi) ↔
      (∀ i, (C'.plank i).lo < (C'.plank i).hi) := by
  induction h with
  | rel _ _ m => exact Move.windowPos_iff m
  | refl _ => exact Iff.rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Equivalent configurations share covering, ledger, gap area — hence
`SqBound` transports along `Config.Equiv`. -/
theorem Config.Equiv.sqBound_iff {C C' : Config} (h : C.Equiv C') :
    C.SqBound ↔ C'.SqBound := by
  simp only [Config.SqBound, Config.deficit, h.sumRelW_eq, h.gapArea_eq]

/-! ## §3  Sectors

Generically the width of the standard triangle along `u` is realized by
exactly one pair of vertices; which pair is a sign condition on `u`.
After `flip` and `scale`, the three open sectors have the rational
normal forms below — the classical ABC parameters. -/

/-- Sector AB: the width along `u` is realized by vertices `A`, `B`
only.  Normal form `(1, b)` with `0 < b < 1`. -/
@[expose] def SectorAB (u : ℝ × ℝ) : Prop :=
  ∃ c b : ℝ, 0 < c ∧ 0 < b ∧ b < 1 ∧
    (u = c • ((1 : ℝ), b) ∨ u = -(c • ((1 : ℝ), b)))

/-- Sector AC: the width along `u` is realized by vertices `A`, `C`
only.  Normal form `(a, 1)` with `0 < a < 1`. -/
@[expose] def SectorAC (u : ℝ × ℝ) : Prop :=
  ∃ c a : ℝ, 0 < c ∧ 0 < a ∧ a < 1 ∧
    (u = c • (a, (1 : ℝ)) ∨ u = -(c • (a, (1 : ℝ))))

/-- Sector BC: the width along `u` is realized by vertices `B`, `C`
only.  Normal form `(a, a − 1)` with `0 < a < 1`. -/
@[expose] def SectorBC (u : ℝ × ℝ) : Prop :=
  ∃ c a : ℝ, 0 < c ∧ 0 < a ∧ a < 1 ∧
    (u = c • (a, a - 1) ∨ u = -(c • (a, a - 1)))

/-- Sector boundaries: `u` is parallel to one of the three edge normals
`(1, 0)`, `(0, 1)`, `(1, 1)` — two vertex shadows tie. -/
@[expose] def SectorBoundary (u : ℝ × ℝ) : Prop :=
  (∃ c : ℝ, c ≠ 0 ∧ (u = c • ((1:ℝ), (0:ℝ)) ∨ u = c • ((0:ℝ), (1:ℝ)) ∨
    u = c • ((1:ℝ), (1:ℝ))))

/-- Every nonzero direction is in exactly one sector or on a boundary
ray — the plane's directions split cleanly. -/
theorem sector_trichotomy {u : ℝ × ℝ} (hu : u ≠ 0) :
    SectorAB u ∨ SectorAC u ∨ SectorBC u ∨ SectorBoundary u :=
  Proofs.Symmetry.sector_trichotomy_raw hu

/-! ### Closed sectors — the flush-robust formulation

The open sectors cannot express a wall normal, which is the
sector-level *flush* configuration — the root cause of the rewrite's
invented flush/anchor/cut chamber-C architecture (tier_601).  The
ancestor (`Dim2N3/ChamberClosedSectors.lean`) works with **closed**
sectors, walls included: every nonzero direction lies in at least one,
and in exactly two iff it is a wall normal.  The closed form is what
the covering umbrella (`Plank/V1.lean`) quantifies over. -/

/-- Closed sector AB: the open sector together with its two walls, the
rays of `(1,0)` and `(1,1)`. -/
@[expose] def ClosedSectorAB (u : ℝ × ℝ) : Prop :=
  SectorAB u ∨ (∃ c : ℝ, c ≠ 0 ∧ u = c • ((1:ℝ), (0:ℝ))) ∨
    (∃ c : ℝ, c ≠ 0 ∧ u = c • ((1:ℝ), (1:ℝ)))

/-- Closed sector AC: the open sector with the rays of `(1,1)` and
`(0,1)`. -/
@[expose] def ClosedSectorAC (u : ℝ × ℝ) : Prop :=
  SectorAC u ∨ (∃ c : ℝ, c ≠ 0 ∧ u = c • ((1:ℝ), (1:ℝ))) ∨
    (∃ c : ℝ, c ≠ 0 ∧ u = c • ((0:ℝ), (1:ℝ)))

/-- Closed sector BC: the open sector with the rays of `(0,1)` and
`(1,0)`. -/
@[expose] def ClosedSectorBC (u : ℝ × ℝ) : Prop :=
  SectorBC u ∨ (∃ c : ℝ, c ≠ 0 ∧ u = c • ((0:ℝ), (1:ℝ))) ∨
    (∃ c : ℝ, c ≠ 0 ∧ u = c • ((1:ℝ), (0:ℝ)))

/-- **The trichotomy with overlap**: every nonzero direction lies in at
least one closed sector. -/
theorem closedSector_cover {u : ℝ × ℝ} (hu : u ≠ 0) :
    ClosedSectorAB u ∨ ClosedSectorAC u ∨ ClosedSectorBC u := by
  rcases sector_trichotomy hu with h | h | h | ⟨c, hc, h | h | h⟩
  · exact Or.inl (Or.inl h)
  · exact Or.inr (Or.inl (Or.inl h))
  · exact Or.inr (Or.inr (Or.inl h))
  · exact Or.inl (Or.inr (Or.inl ⟨c, hc, h⟩))
  · exact Or.inr (Or.inl (Or.inr (Or.inr ⟨c, hc, h⟩)))
  · exact Or.inl (Or.inr (Or.inr ⟨c, hc, h⟩))

/-- **A boundary ray lies in two closed sectors.**  Each wall is shared by
the two sectors it separates, so a direction on it belongs to both — this
is what makes the closed-sector umbrella settle chamber C by pigeonhole,
with no flush plank and no cut recursion. -/
theorem boundary_mem_two {u : ℝ × ℝ} (h : SectorBoundary u) :
    (ClosedSectorAB u ∧ ClosedSectorBC u) ∨ (ClosedSectorAC u ∧ ClosedSectorBC u)
      ∨ (ClosedSectorAB u ∧ ClosedSectorAC u) := by
  obtain ⟨c, hc, h1 | h1 | h1⟩ := h
  · exact Or.inl ⟨Or.inr (Or.inl ⟨c, hc, h1⟩), Or.inr (Or.inr ⟨c, hc, h1⟩)⟩
  · exact Or.inr (Or.inl ⟨Or.inr (Or.inr ⟨c, hc, h1⟩), Or.inr (Or.inl ⟨c, hc, h1⟩)⟩)
  · exact Or.inr (Or.inr ⟨Or.inr (Or.inr ⟨c, hc, h1⟩), Or.inr (Or.inl ⟨c, hc, h1⟩)⟩)

/-- **Closed sector AB in parameter form**: every direction of the
closed sector is `± c · (1, b)` with `c > 0` and `b ∈ [0,1]` — the walls
are the endpoints `b = 0` and `b = 1`.  This is the form in which the
sector's defining property is usable: the first coordinate carries the
whole width. -/
theorem ClosedSectorAB.form {u : ℝ × ℝ} (h : ClosedSectorAB u) :
    ∃ c b : ℝ, 0 < c ∧ 0 ≤ b ∧ b ≤ 1 ∧
      (u = c • ((1 : ℝ), b) ∨ u = -(c • ((1 : ℝ), b))) := by
  rcases h with ⟨c, b, hc, hb0, hb1, hu⟩ | ⟨c, hc, hu⟩ | ⟨c, hc, hu⟩
  · exact ⟨c, b, hc, hb0.le, hb1.le, hu⟩
  · rcases lt_or_gt_of_ne hc with hneg | hpos
    · exact ⟨-c, 0, by linarith, le_refl 0, zero_le_one,
        Or.inr (by rw [hu, neg_smul, neg_neg])⟩
    · exact ⟨c, 0, hpos, le_refl 0, zero_le_one, Or.inl hu⟩
  · rcases lt_or_gt_of_ne hc with hneg | hpos
    · exact ⟨-c, 1, by linarith, zero_le_one, le_refl 1,
        Or.inr (by rw [hu, neg_smul, neg_neg])⟩
    · exact ⟨c, 1, hpos, zero_le_one, le_refl 1, Or.inl hu⟩

/-- The first coordinate of a closed-AB normal carries its whole
standard width — the sector's defining property (the width is realised
by the vertices `A` and `B`) in the form the bottom-edge argument
needs. -/
theorem ClosedSectorAB.abs_fst_eq_width {u : ℝ × ℝ} (h : ClosedSectorAB u) :
    |u.1| = stdTriangle.width u := by
  obtain ⟨c, b, hc, hb0, hb1, hu | hu⟩ := h.form
  · have h1 : u.1 = c := by rw [hu]; simp
    have h2 : u.2 = c * b := by rw [hu]; simp
    have hcb0 : 0 ≤ c * b := mul_nonneg hc.le hb0
    have hcb1 : c * b ≤ c := by nlinarith
    rw [stdTriangle_width_eq, h1, h2, abs_of_pos hc]
    simp only [max_def, min_def]
    split_ifs <;> linarith
  · have h1 : u.1 = -c := by rw [hu]; simp
    have h2 : u.2 = -(c * b) := by rw [hu]; simp
    have hcb0 : 0 ≤ c * b := mul_nonneg hc.le hb0
    have hcb1 : c * b ≤ c := by nlinarith
    rw [stdTriangle_width_eq, h1, h2, abs_of_neg (by linarith : -c < 0)]
    simp only [max_def, min_def]
    split_ifs <;> linarith

/-! The open sectors are pairwise disjoint: each pair forces `ab = 1` or
a negative parameter, both excluded by the `(0,1)` ranges.  This is what
turns "in two closed sectors" into "on a wall". -/

theorem sectorAB_not_AC {u : ℝ × ℝ} (h1 : SectorAB u) (h2 : SectorAC u) : False := by
  obtain ⟨c, b, hc, hb0, hb1, hu1 | hu1⟩ := h1 <;>
    obtain ⟨c', a, hc', ha0, ha1, hu2 | hu2⟩ := h2 <;>
    · rw [hu1] at hu2
      have e1 := congrArg Prod.fst hu2
      have e2 := congrArg Prod.snd hu2
      simp only [Prod.fst_neg, Prod.snd_neg, Prod.smul_fst, Prod.smul_snd, smul_eq_mul,
        mul_one] at e1 e2
      nlinarith

theorem sectorAB_not_BC {u : ℝ × ℝ} (h1 : SectorAB u) (h2 : SectorBC u) : False := by
  obtain ⟨c, b, hc, hb0, hb1, hu1 | hu1⟩ := h1 <;>
    obtain ⟨c', a, hc', ha0, ha1, hu2 | hu2⟩ := h2 <;>
    · rw [hu1] at hu2
      have e1 := congrArg Prod.fst hu2
      have e2 := congrArg Prod.snd hu2
      simp only [Prod.fst_neg, Prod.snd_neg, Prod.smul_fst, Prod.smul_snd, smul_eq_mul,
        mul_one] at e1 e2
      nlinarith

theorem sectorAC_not_BC {u : ℝ × ℝ} (h1 : SectorAC u) (h2 : SectorBC u) : False := by
  obtain ⟨c, b, hc, hb0, hb1, hu1 | hu1⟩ := h1 <;>
    obtain ⟨c', a, hc', ha0, ha1, hu2 | hu2⟩ := h2 <;>
    · rw [hu1] at hu2
      have e1 := congrArg Prod.fst hu2
      have e2 := congrArg Prod.snd hu2
      simp only [Prod.fst_neg, Prod.snd_neg, Prod.smul_fst, Prod.smul_snd, smul_eq_mul,
        mul_one] at e1 e2
      nlinarith

/-- Two closed sectors overlap exactly on the walls: a direction lies
in two of them iff it is a boundary-ray normal (and each wall belongs
to exactly its two adjacent sectors). -/
theorem closedSector_pair_iff_wall {u : ℝ × ℝ} (hu : u ≠ 0) :
    ((ClosedSectorAB u ∧ ClosedSectorAC u) ∨
     (ClosedSectorAB u ∧ ClosedSectorBC u) ∨
     (ClosedSectorAC u ∧ ClosedSectorBC u)) ↔ SectorBoundary u := by
  constructor
  · rintro (⟨hA, hB⟩ | ⟨hA, hB⟩ | ⟨hA, hB⟩)
    · rcases hA with h | ⟨c, hc, h⟩ | ⟨c, hc, h⟩
      · rcases hB with h' | ⟨c, hc, h'⟩ | ⟨c, hc, h'⟩
        · exact absurd h' (fun h'' => sectorAB_not_AC h h'')
        · exact ⟨c, hc, Or.inr (Or.inr h')⟩
        · exact ⟨c, hc, Or.inr (Or.inl h')⟩
      · exact ⟨c, hc, Or.inl h⟩
      · exact ⟨c, hc, Or.inr (Or.inr h)⟩
    · rcases hA with h | ⟨c, hc, h⟩ | ⟨c, hc, h⟩
      · rcases hB with h' | ⟨c, hc, h'⟩ | ⟨c, hc, h'⟩
        · exact absurd h' (fun h'' => sectorAB_not_BC h h'')
        · exact ⟨c, hc, Or.inr (Or.inl h')⟩
        · exact ⟨c, hc, Or.inl h'⟩
      · exact ⟨c, hc, Or.inl h⟩
      · exact ⟨c, hc, Or.inr (Or.inr h)⟩
    · rcases hA with h | ⟨c, hc, h⟩ | ⟨c, hc, h⟩
      · rcases hB with h' | ⟨c, hc, h'⟩ | ⟨c, hc, h'⟩
        · exact absurd h' (fun h'' => sectorAC_not_BC h h'')
        · exact ⟨c, hc, Or.inr (Or.inl h')⟩
        · exact ⟨c, hc, Or.inl h'⟩
      · exact ⟨c, hc, Or.inr (Or.inr h)⟩
      · exact ⟨c, hc, Or.inr (Or.inl h)⟩
  · rintro ⟨c, hc, h | h | h⟩
    · exact Or.inr (Or.inl ⟨Or.inr (Or.inl ⟨c, hc, h⟩), Or.inr (Or.inr ⟨c, hc, h⟩)⟩)
    · exact Or.inr (Or.inr ⟨Or.inr (Or.inr ⟨c, hc, h⟩), Or.inr (Or.inl ⟨c, hc, h⟩)⟩)
    · exact Or.inl ⟨Or.inr (Or.inr ⟨c, hc, h⟩), Or.inr (Or.inl ⟨c, hc, h⟩)⟩

/-! ### The dual action on sectors and boundary rays

The triangle symmetries act on *normals* by the transposed linear
parts — the formulas inside `Move.rot` and `Move.swap`.  How they
permute the three sectors and the three boundary rays is what picks
the normalizing group element in every chamber normal form:
`rot` cycles the sectors `AB → AC → BC → AB` and the rays
`(1,0) → (1,1) → (0,1) → (1,0)`; `swap` exchanges `AB ↔ AC` and
`(1,0) ↔ (0,1)`, fixing `BC` and the ray `(1,1)`. -/

/-- The normal (dual) map of `Move.rot`: `u ↦ (u₂ − u₁, −u₁)` — the
transpose of `rotStd`'s linear part. -/
@[expose] def rotDual (u : ℝ × ℝ) : ℝ × ℝ := (u.2 - u.1, -u.1)

/-- The normal (dual) map of `Move.swap`: coordinate exchange. -/
@[expose] def swapDual (u : ℝ × ℝ) : ℝ × ℝ := (u.2, u.1)

/-- `rot` sends sector AB to sector AC. -/
theorem SectorAB.rotDual {u : ℝ × ℝ} (h : SectorAB u) :
    SectorAC (rotDual u) := by
  obtain ⟨c, b, hc, hb0, hb1, hu | hu⟩ := h
  · exact ⟨c, 1 - b, hc, by linarith, by linarith, Or.inr (by
      rw [hu]; simp only [_root_.rotDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩
  · exact ⟨c, 1 - b, hc, by linarith, by linarith, Or.inl (by
      rw [hu]; simp only [_root_.rotDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩

/-- `rot` sends sector AC to sector BC. -/
theorem SectorAC.rotDual {u : ℝ × ℝ} (h : SectorAC u) :
    SectorBC (rotDual u) := by
  obtain ⟨c, a, hc, ha0, ha1, hu | hu⟩ := h
  · exact ⟨c, 1 - a, hc, by linarith, by linarith, Or.inl (by
      rw [hu]; simp only [_root_.rotDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩
  · exact ⟨c, 1 - a, hc, by linarith, by linarith, Or.inr (by
      rw [hu]; simp only [_root_.rotDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩

/-- `rot` sends sector BC to sector AB. -/
theorem SectorBC.rotDual {u : ℝ × ℝ} (h : SectorBC u) :
    SectorAB (rotDual u) := by
  obtain ⟨c, a, hc, ha0, ha1, hu | hu⟩ := h
  · exact ⟨c, a, hc, ha0, ha1, Or.inr (by
      rw [hu]; simp only [_root_.rotDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩
  · exact ⟨c, a, hc, ha0, ha1, Or.inl (by
      rw [hu]; simp only [_root_.rotDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩

/-- `swap` exchanges sectors AB and AC. -/
theorem SectorAB.swapDual {u : ℝ × ℝ} (h : SectorAB u) :
    SectorAC (swapDual u) := by
  obtain ⟨c, b, hc, hb0, hb1, hu | hu⟩ := h
  · exact ⟨c, b, hc, hb0, hb1, Or.inl (by
      rw [hu]; simp only [_root_.swapDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩
  · exact ⟨c, b, hc, hb0, hb1, Or.inr (by
      rw [hu]; simp only [_root_.swapDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩

/-- `swap` exchanges sectors AC and AB. -/
theorem SectorAC.swapDual {u : ℝ × ℝ} (h : SectorAC u) :
    SectorAB (swapDual u) := by
  obtain ⟨c, a, hc, ha0, ha1, hu | hu⟩ := h
  · exact ⟨c, a, hc, ha0, ha1, Or.inl (by
      rw [hu]; simp only [_root_.swapDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩
  · exact ⟨c, a, hc, ha0, ha1, Or.inr (by
      rw [hu]; simp only [_root_.swapDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩

/-- `swap` fixes sector BC (reversing its parameter, `a ↦ 1 − a`). -/
theorem SectorBC.swapDual {u : ℝ × ℝ} (h : SectorBC u) :
    SectorBC (swapDual u) := by
  obtain ⟨c, a, hc, ha0, ha1, hu | hu⟩ := h
  · exact ⟨c, 1 - a, hc, by linarith, by linarith, Or.inr (by
      rw [hu]; simp only [_root_.swapDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩
  · exact ⟨c, 1 - a, hc, by linarith, by linarith, Or.inl (by
      rw [hu]; simp only [_root_.swapDual, smul_pair, Prod.neg_mk, Prod.mk.injEq]
      try constructor
      all_goals first | ring | trivial)⟩

/-- `rot` on the ray of `(1,0)`: lands on the ray of `(1,1)`. -/
theorem rotDual_ray10 (c : ℝ) :
    rotDual (c • ((1 : ℝ), (0 : ℝ))) = (-c) • ((1 : ℝ), (1 : ℝ)) := by
  simp only [rotDual, smul_pair, Prod.mk.injEq]
  try constructor
  all_goals first | ring | trivial

/-- `rot` on the ray of `(0,1)`: lands on the ray of `(1,0)`. -/
theorem rotDual_ray01 (c : ℝ) :
    rotDual (c • ((0 : ℝ), (1 : ℝ))) = c • ((1 : ℝ), (0 : ℝ)) := by
  simp only [rotDual, smul_pair, Prod.mk.injEq]
  try constructor
  all_goals first | ring | trivial

/-- `rot` on the ray of `(1,1)`: lands on the ray of `(0,1)`. -/
theorem rotDual_ray11 (c : ℝ) :
    rotDual (c • ((1 : ℝ), (1 : ℝ))) = (-c) • ((0 : ℝ), (1 : ℝ)) := by
  simp only [rotDual, smul_pair, Prod.mk.injEq]
  try constructor
  all_goals first | ring | trivial

/-- `swap` exchanges the rays of `(1,0)` and `(0,1)` and fixes the ray
of `(1,1)`. -/
theorem swapDual_rays (c : ℝ) :
    swapDual (c • ((1 : ℝ), (0 : ℝ))) = c • ((0 : ℝ), (1 : ℝ)) ∧
    swapDual (c • ((0 : ℝ), (1 : ℝ))) = c • ((1 : ℝ), (0 : ℝ)) ∧
    swapDual (c • ((1 : ℝ), (1 : ℝ))) = c • ((1 : ℝ), (1 : ℝ)) := by
  refine ⟨?_, ?_, ?_⟩ <;>
    (simp only [swapDual, smul_pair, Prod.mk.injEq]; try constructor
     all_goals first | ring | trivial)

/-- Boundary rays stay boundary rays under both dual maps. -/
theorem SectorBoundary.dual {u : ℝ × ℝ} (h : SectorBoundary u) :
    SectorBoundary (rotDual u) ∧ SectorBoundary (swapDual u) := by
  obtain ⟨c, hc, hu | hu | hu⟩ := h
  · exact ⟨⟨-c, neg_ne_zero.mpr hc, Or.inr (Or.inr (by rw [hu, rotDual_ray10]))⟩,
      ⟨c, hc, Or.inr (Or.inl (by rw [hu, (swapDual_rays c).1]))⟩⟩
  · exact ⟨⟨c, hc, Or.inl (by rw [hu, rotDual_ray01])⟩,
      ⟨c, hc, Or.inl (by rw [hu, (swapDual_rays c).2.1])⟩⟩
  · exact ⟨⟨-c, neg_ne_zero.mpr hc, Or.inr (Or.inl (by rw [hu, rotDual_ray11]))⟩,
      ⟨c, hc, Or.inr (Or.inr (by rw [hu, (swapDual_rays c).2.2]))⟩⟩

/-- Closed sector AC in parameter form. -/
theorem ClosedSectorAC.form {u : ℝ × ℝ} (h : ClosedSectorAC u) :
    ∃ c a : ℝ, 0 < c ∧ 0 ≤ a ∧ a ≤ 1 ∧
      (u = c • (a, (1 : ℝ)) ∨ u = -(c • (a, (1 : ℝ)))) := by
  rcases h with ⟨c, a, hc, ha0, ha1, hu⟩ | ⟨c, hc, hu⟩ | ⟨c, hc, hu⟩
  · exact ⟨c, a, hc, ha0.le, ha1.le, hu⟩
  · rcases lt_or_gt_of_ne hc with hneg | hpos
    · exact ⟨-c, 1, by linarith, zero_le_one, le_refl 1,
        Or.inr (by rw [hu, neg_smul, neg_neg])⟩
    · exact ⟨c, 1, hpos, zero_le_one, le_refl 1, Or.inl hu⟩
  · rcases lt_or_gt_of_ne hc with hneg | hpos
    · exact ⟨-c, 0, by linarith, le_refl 0, zero_le_one,
        Or.inr (by rw [hu, neg_smul, neg_neg])⟩
    · exact ⟨c, 0, hpos, le_refl 0, zero_le_one, Or.inl hu⟩

/-! ### The dual action on CLOSED sectors

Each generator carries a closed sector to a closed sector: the open part
by the open transport, the two walls by `rotDual_ray*` / `swapDual_rays`.
This is what lets the umbrella's dispatch move any ordered pair of
distinct closed sectors to `(AB, AC)`. -/

theorem ClosedSectorAB.rotDual {u : ℝ × ℝ} (h : ClosedSectorAB u) :
    ClosedSectorAC (rotDual u) := by
  rcases h with h | ⟨c, hc, hu⟩ | ⟨c, hc, hu⟩
  · exact Or.inl h.rotDual
  · exact Or.inr (Or.inl ⟨-c, neg_ne_zero.mpr hc, by rw [hu, rotDual_ray10]⟩)
  · exact Or.inr (Or.inr ⟨-c, neg_ne_zero.mpr hc, by rw [hu, rotDual_ray11]⟩)

theorem ClosedSectorAC.rotDual {u : ℝ × ℝ} (h : ClosedSectorAC u) :
    ClosedSectorBC (rotDual u) := by
  rcases h with h | ⟨c, hc, hu⟩ | ⟨c, hc, hu⟩
  · exact Or.inl h.rotDual
  · exact Or.inr (Or.inl ⟨-c, neg_ne_zero.mpr hc, by rw [hu, rotDual_ray11]⟩)
  · exact Or.inr (Or.inr ⟨c, hc, by rw [hu, rotDual_ray01]⟩)

theorem ClosedSectorBC.rotDual {u : ℝ × ℝ} (h : ClosedSectorBC u) :
    ClosedSectorAB (rotDual u) := by
  rcases h with h | ⟨c, hc, hu⟩ | ⟨c, hc, hu⟩
  · exact Or.inl h.rotDual
  · exact Or.inr (Or.inl ⟨c, hc, by rw [hu, rotDual_ray01]⟩)
  · exact Or.inr (Or.inr ⟨-c, neg_ne_zero.mpr hc, by rw [hu, rotDual_ray10]⟩)

theorem ClosedSectorAB.swapDual {u : ℝ × ℝ} (h : ClosedSectorAB u) :
    ClosedSectorAC (swapDual u) := by
  rcases h with h | ⟨c, hc, hu⟩ | ⟨c, hc, hu⟩
  · exact Or.inl h.swapDual
  · exact Or.inr (Or.inr ⟨c, hc, by rw [hu, (swapDual_rays c).1]⟩)
  · exact Or.inr (Or.inl ⟨c, hc, by rw [hu, (swapDual_rays c).2.2]⟩)

theorem ClosedSectorAC.swapDual {u : ℝ × ℝ} (h : ClosedSectorAC u) :
    ClosedSectorAB (swapDual u) := by
  rcases h with h | ⟨c, hc, hu⟩ | ⟨c, hc, hu⟩
  · exact Or.inl h.swapDual
  · exact Or.inr (Or.inr ⟨c, hc, by rw [hu, (swapDual_rays c).2.2]⟩)
  · exact Or.inr (Or.inl ⟨c, hc, by rw [hu, (swapDual_rays c).2.1]⟩)

theorem ClosedSectorBC.swapDual {u : ℝ × ℝ} (h : ClosedSectorBC u) :
    ClosedSectorBC (swapDual u) := by
  rcases h with h | ⟨c, hc, hu⟩ | ⟨c, hc, hu⟩
  · exact Or.inl h.swapDual
  · exact Or.inr (Or.inr ⟨c, hc, by rw [hu, (swapDual_rays c).2.1]⟩)
  · exact Or.inr (Or.inl ⟨c, hc, by rw [hu, (swapDual_rays c).1]⟩)

/-- **Every boundary ray reaches `(1,0)`**: some element of the
symmetry group generated by `rot` and `swap` carries a boundary normal
to a nonzero multiple of `(1,0)` — the group element `chamberC_anchor`
applies. -/
theorem SectorBoundary.reaches_ray10 {u : ℝ × ℝ} (h : SectorBoundary u) :
    (∃ c : ℝ, c ≠ 0 ∧ u = c • ((1 : ℝ), (0 : ℝ))) ∨
    (∃ c : ℝ, c ≠ 0 ∧ rotDual u = c • ((1 : ℝ), (0 : ℝ))) ∨
    (∃ c : ℝ, c ≠ 0 ∧ rotDual (rotDual u) = c • ((1 : ℝ), (0 : ℝ))) := by
  obtain ⟨c, hc, hu | hu | hu⟩ := h
  · exact Or.inl ⟨c, hc, hu⟩
  · exact Or.inr (Or.inl ⟨c, hc, by rw [hu, rotDual_ray01]⟩)
  · refine Or.inr (Or.inr ⟨-c, neg_ne_zero.mpr hc, ?_⟩)
    rw [hu, rotDual_ray11, rotDual_ray01]

/-! ## §4  The four chambers

Up to moves, a configuration is classified by which sectors its three
normals occupy.  The names follow the old census: **T** (all three in
one sector — tiling-like), **C** (a normal on a boundary ray), **D**
(two sectors), **E** (all three sectors — the hexagonal chamber, where
the interesting mathematics happens).  Chamber E has the rational
normal form `abcConfig`. -/

/-- The **ABC normal form**: normals `(1, b₀)`, `(a₁, 1)`, `(a₂, a₂−1)`,
one per sector, with windows `lo`, `hi`.  Chamber E's coordinates. -/
@[expose] def abcConfig (b₀ a₁ a₂ : ℝ) (hb : 0 < b₀ ∧ b₀ < 1) (ha₁ : 0 < a₁ ∧ a₁ < 1)
    (ha₂ : 0 < a₂ ∧ a₂ < 1) (lo hi : Fin 3 → ℝ) (hle : ∀ i, lo i ≤ hi i) :
    Config :=
  ⟨![⟨((1 : ℝ), b₀), lo 0, hi 0,
      fun h => one_ne_zero (congrArg Prod.fst h), hle 0⟩,
     ⟨(a₁, (1 : ℝ)), lo 1, hi 1,
      fun h => one_ne_zero (congrArg Prod.snd h), hle 1⟩,
     ⟨(a₂, a₂ - 1), lo 2, hi 2,
      fun h => ne_of_gt ha₂.1 (congrArg Prod.fst h), hle 2⟩]⟩

/-- A configuration is **in chamber T** if all three normals lie in one
common sector. -/
@[expose] def Config.ChamberT (C : Config) : Prop :=
  (∀ i, SectorAB (C.plank i).u) ∨ (∀ i, SectorAC (C.plank i).u) ∨
    (∀ i, SectorBC (C.plank i).u)

/-- A configuration is **in chamber C** if some normal lies on a sector
boundary ray. -/
@[expose] def Config.ChamberC (C : Config) : Prop :=
  ∃ i, SectorBoundary (C.plank i).u

/-- A configuration is **in chamber D** if its normals occupy exactly
two of the three open sectors.  The bare covering condition
`∀ i, AB ∨ AC` is *not* a chamber — chamber T satisfies it (all three
normals in AB), so the dispatch's cases would overlap and a chamber-D
lemma would inherit chamber-T configurations such as the staircase.
The negative clause is exactly what `Config.exists_chamber` already has
in context when it reaches this branch.  (tier_594 §1.3.) -/
@[expose] def Config.ChamberD (C : Config) : Prop :=
  ¬ C.ChamberT ∧
    ((∀ i, SectorAB (C.plank i).u ∨ SectorAC (C.plank i).u) ∨
     (∀ i, SectorAB (C.plank i).u ∨ SectorBC (C.plank i).u) ∨
     (∀ i, SectorAC (C.plank i).u ∨ SectorBC (C.plank i).u))

/-- A configuration is **in chamber E** if it is (a relabeling of) the
ABC normal form: one normal in each sector. -/
@[expose] def Config.ChamberE (C : Config) : Prop :=
  SectorAB (C.plank 0).u ∧ SectorAC (C.plank 1).u ∧ SectorBC (C.plank 2).u

/-- Sorting three normals, one per sector, into the ABC order: the only
move the dispatch ever needs. -/
theorem Config.chamberE_dispatch (C : Config) (i j k : Fin 3)
    (hinj : Function.Injective (![i, j, k] : Fin 3 → Fin 3))
    (hi : SectorAB (C.plank i).u) (hj : SectorAC (C.plank j).u)
    (hk : SectorBC (C.plank k).u) :
    ∃ C', C.Equiv C' ∧
      (C'.ChamberT ∨ C'.ChamberC ∨ C'.ChamberD ∨ C'.ChamberE) :=
  ⟨⟨C.plank ∘ Equiv.ofBijective _ (Finite.injective_iff_bijective.mp hinj)⟩,
    Relation.EqvGen.rel _ _ (Move.relabel C _),
    Or.inr (Or.inr (Or.inr ⟨hi, hj, hk⟩))⟩

/-- **The chamber dispatch**: every configuration is equivalent, under
moves, to one lying in a chamber.  (The old 27-triple sector census,
without a single cosine.) -/
theorem Config.exists_chamber (C : Config) :
    ∃ C', C.Equiv C' ∧
      (C'.ChamberT ∨ C'.ChamberC ∨ C'.ChamberD ∨ C'.ChamberE) := by
  by_cases hb : ∃ i, SectorBoundary (C.plank i).u
  · exact ⟨C, Relation.EqvGen.refl C, Or.inr (Or.inl hb)⟩
  push_neg at hb
  have h : ∀ i, SectorAB (C.plank i).u ∨ SectorAC (C.plank i).u ∨
      SectorBC (C.plank i).u := by
    intro i
    rcases sector_trichotomy (C.plank i).u_ne_zero with h | h | h | h
    exacts [Or.inl h, Or.inr (Or.inl h), Or.inr (Or.inr h), absurd h (hb i)]
  by_cases hT₁ : ∀ i, SectorAB (C.plank i).u
  · exact ⟨C, Relation.EqvGen.refl C, Or.inl (Or.inl hT₁)⟩
  by_cases hT₂ : ∀ i, SectorAC (C.plank i).u
  · exact ⟨C, Relation.EqvGen.refl C, Or.inl (Or.inr (Or.inl hT₂))⟩
  by_cases hT₃ : ∀ i, SectorBC (C.plank i).u
  · exact ⟨C, Relation.EqvGen.refl C, Or.inl (Or.inr (Or.inr hT₃))⟩
  have hT : ¬ Config.ChamberT C :=
    fun h => h.elim hT₁ (fun h' => h'.elim hT₂ hT₃)
  by_cases hD₁ : ∀ i, SectorAB (C.plank i).u ∨ SectorAC (C.plank i).u
  · exact ⟨C, Relation.EqvGen.refl C,
      Or.inr (Or.inr (Or.inl ⟨hT, Or.inl hD₁⟩))⟩
  by_cases hD₂ : ∀ i, SectorAB (C.plank i).u ∨ SectorBC (C.plank i).u
  · exact ⟨C, Relation.EqvGen.refl C,
      Or.inr (Or.inr (Or.inl ⟨hT, Or.inr (Or.inl hD₂)⟩))⟩
  by_cases hD₃ : ∀ i, SectorAC (C.plank i).u ∨ SectorBC (C.plank i).u
  · exact ⟨C, Relation.EqvGen.refl C,
      Or.inr (Or.inr (Or.inl ⟨hT, Or.inr (Or.inr hD₃)⟩))⟩
  -- all three sectors occupied: one relabeling puts them in ABC order
  push_neg at hD₁ hD₂ hD₃
  obtain ⟨k, hk₁, hk₂⟩ := hD₁
  obtain ⟨j, hj₁, hj₂⟩ := hD₂
  obtain ⟨i, hi₁, hi₂⟩ := hD₃
  have hi : SectorAB (C.plank i).u := by
    rcases h i with a | a | a
    exacts [a, absurd a hi₁, absurd a hi₂]
  have hj : SectorAC (C.plank j).u := by
    rcases h j with a | a | a
    exacts [absurd a hj₁, a, absurd a hj₂]
  have hk : SectorBC (C.plank k).u := by
    rcases h k with a | a | a
    exacts [absurd a hk₁, absurd a hk₂, a]
  refine Config.chamberE_dispatch C i j k
    (Proofs.Symmetry.inj_three ?_ ?_ ?_) hi hj hk
  · rintro rfl; exact hj₁ hi
  · rintro rfl; exact hk₁ hi
  · rintro rfl; exact hk₂ hj

end
